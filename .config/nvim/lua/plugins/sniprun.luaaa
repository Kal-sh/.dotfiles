return {
  {
    "michaelb/sniprun",
    build = "bash ./install.sh",

    ft = {
      "markdown",
      "text",
      "python",
      "javascript",
      "typescript",
    },

    config = function()
      require("sniprun").setup({
        selected_interpreters = { "Python3_fifo", "Generic" },

        repl_enable = { "Python3_fifo" },

        interpreter_options = {
          Generic = {
            NodeJS = {
              supported_filetypes = { "javascript", "typescript" },
              extension = ".js",
              interpreter = "node",
            },
          },
        },
      })

      vim.keymap.set("v", "<leader>rs", ":'<,'>SnipRun<CR>", { silent = true })
      vim.keymap.set("n", "<leader>rs", "<cmd>SnipRun<CR>", { silent = true })
      vim.keymap.set("n", "<leader>rc", "<cmd>SnipClose<CR>", { silent = true })
      vim.keymap.set("n", "<leader>rz", "<cmd>SnipReset<CR>", { silent = true })
    end,
  },
}
